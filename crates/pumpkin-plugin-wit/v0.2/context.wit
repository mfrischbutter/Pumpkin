/// The core context provided to a plugin during initialization and event handling.
interface context {
    use server.{server};
    use event.{event-type, event-priority};
    use command.{command};
    use permission.{permission};
    use common.{nbt-tree};
    use text.{text-component};

    /// Verified marketplace metadata for signed plugins.
    record marketplace-metadata {
        /// The marketplace base URL where this plugin is registered.
        marketplace-url: string,
        /// The unique plugin ID on the marketplace.
        plugin-id: s64,
        /// The canonical plugin name.
        plugin-name: string,
        /// The semver version string of the plugin.
        version: string,
        /// Developer ID.
        dev-id: s64,
        /// Developer display name or username.
        dev-name: string,
        /// Whether this is a paid marketplace plugin.
        is-paid: bool,
        /// The buyer / licensee user ID (0 for free/open-source).
        user-id: s64,
        /// Unique license key issued to the buyer, if paid.
        license-key: option<string>,
        /// ISO-8601 timestamp of when this binary/license was issued.
        issued-at: string,
    }

    /// A contextual handle for plugin-related operations.
    resource context {
        /// Registers a handler for a specific event.
        ///
        /// * `handler-id`: Unique ID for the event handler.
        /// * `event-type`: The type of event to listen for.
        /// * `event-priority`: When this handler should be called relative to others.
        /// * `blocking`: If true, the returned event updates the event being
        ///   dispatched. Otherwise the result is ignored. Either kind of
        ///   handler may suspend
        register-event: func(handler-id: u32, event-type: event-type, event-priority: event-priority, blocking: bool);

        /// Registers a new command.
        ///
        /// * `command`: The command definition.
        /// * `permission`: The required permission node to execute this command.
        register-command: func(command: command, permission: string);

        /// Registers a permission node with the server.
        register-permission: func(permission: permission) -> result<_, string>;

        /// Limits this plugin's `packet-sent-event` handlers to packets with these ids, so other
        /// packets are not copied into the plugin. An empty list removes the limit (the default).
        set-packet-sent-filter: func(ids: list<s32>);
        /// Registers a loot table from its JSON definition, in the format of a datapack's
        /// `data/<namespace>/loot_table/<path>.json`. It replaces a vanilla table with the same id,
        /// while a datapack table with the same id still wins. The table stays registered across
        /// `/reload` until the plugin unloads.
        register-loot-table: func(id: string, json: string) -> result<_, string>;
        /// Adds an entry to a synced registry, such as `minecraft:chat_type` or
        /// `minecraft:wolf_variant`.
        ///
        /// * `registry`: The registry id; `minecraft:` may be left out.
        /// * `id`: The namespaced entry id. The `minecraft` namespace is refused.
        /// * `data`: The entry as an NBT compound, in the form a datapack defines it.
        ///
        /// Players receive the entry from their next configuration on, so register entries
        /// while the plugin loads. The entry is removed when the plugin unloads. Registries the
        /// server simulates itself (damage types, enchantments, jukebox songs, biomes) are refused.
        register-registry-entry: func(registry: string, id: string, data: nbt-tree) -> result<_, string>;

        /// Registers a jukebox song. Jukeboxes play discs whose `jukebox_playable` component
        /// names `id`, for `length-seconds`, with `comparator-output` (0 to 15) as the comparator
        /// signal; clients show `description` while it plays and in the disc's tooltip.
        ///
        /// * `id`: The namespaced song id. The `minecraft` namespace is refused.
        /// * `sound-event`: The sound to play, e.g. a sound from a resource pack.
        ///
        /// Like `register-registry-entry`, players receive the song from their next
        /// configuration on, and it is removed when the plugin unloads.
        register-jukebox-song: func(id: string, sound-event: string, description: text-component, length-seconds: f32, comparator-output: u8) -> result<_, string>;

        /// Returns the path to the plugin's private data folder.
        get-data-folder: func() -> string;

        /// Returns the global server instance.
        get-server: func() -> server;

        /// Returns verified marketplace metadata if this plugin binary is signed, or none if unsigned.
        get-marketplace-metadata: func() -> option<marketplace-metadata>;

        /// Fires `block-shape-update-event` for shape updates that would change one of
        /// `states` (block state ids).
        ///
        /// Replaces the states this plugin watched before; an empty list stops watching.
        /// Ids that are not block states are ignored.
        watch-block-states: func(states: list<u16>);

        /// Fires `block-scheduled-tick-event` before each scheduled tick of `block`
        /// (a namespaced block name such as "minecraft:fire") runs.
        ///
        /// Returns false if the block is unknown.
        register-scheduled-tick-hook: func(block: string) -> bool;

        /// Fires `block-random-tick-event` for random ticks of `states` (block state ids).
        /// States vanilla never random ticks start getting random ticks at the vanilla rate;
        /// those ticks only reach plugins.
        ///
        /// Replaces the states this plugin watched before; an empty list stops watching.
        /// Ids that are not block states are ignored.
        watch-random-tick-states: func(states: list<u16>);
    }
}

